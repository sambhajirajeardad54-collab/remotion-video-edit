# Root rules for the platform workspaces only.
# The Remotion video project keeps its own rules in apps/video/.gitignore
# (unchanged from before the monorepo); rules here are anchored so they
# never reach into apps/video.

node_modules/
.DS_Store
*.tsbuildinfo
/coverage/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.keystore
*.jks

# Shared packages
/packages/*/dist/

# Next.js
/apps/web/.next/
/apps/web/out/
/apps/web/next-env.d.ts

# Expo / React Native
/apps/mobile/.expo/
/apps/mobile/dist/
/apps/mobile/android/
/apps/mobile/ios/
/apps/mobile/web-build/
/apps/mobile/expo-env.d.ts

# Test artefacts
test-results/
playwright-report/
/screenshots/

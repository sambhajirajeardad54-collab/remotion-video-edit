{
  "name": "edu-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Coaching institute platform (web + Android) and the Sam Xplains Remotion video studio, in one repository.",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @edu/web",
    "dev:mobile": "npm run start -w @edu/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build -w @edu/web",
    "export:android": "npm run export:android -w @edu/mobile",
    "check": "npm run typecheck && npm run test && npm run build:web && npm run export:android",

    "video:install": "npm ci --prefix apps/video",
    "video:dev": "npm run dev --prefix apps/video",
    "video:lint": "npm run lint --prefix apps/video",
    "video:render": "npm run render:final --prefix apps/video --"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}

{
  "name": "edu-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Coaching institute platform for MPSC Group C, Group D and DMER aspirants (web + Android).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @edu/web",
    "dev:mobile": "npm run start -w @edu/mobile",
    "dev:video": "npm run dev -w @edu/video",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build -w @edu/web",
    "export:android": "npm run export:android -w @edu/mobile",
    "check": "npm run typecheck && npm run test && npm run build:web && npm run export:android",
    "e2e:web": "npm run e2e -w @edu/web"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
